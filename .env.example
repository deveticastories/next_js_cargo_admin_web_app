# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored — never commit real credentials.

# MongoDB Atlas connection string. Any special characters in the username
# or password (@, :, /, %, ...) must be percent-encoded, e.g. "@" -> "%40".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Signing secrets for the access/refresh JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Used once by `npm run seed:admin` to create the first admin account.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
